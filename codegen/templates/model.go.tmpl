{{- /*
Templates for model files. Each type gets a declaration, and every named
type gets a Validate method. Helpers marked "stmts" return Go statements
built by the generator.
*/ -}}

{{define "types"}}
{{- range .}}
{{- if eq (kind .) "struct"}}{{template "struct" .}}
{{- else if eq (kind .) "union"}}{{template "union" .}}
{{- else if eq (kind .) "enum"}}{{template "enum" .}}
{{- else if eq (kind .) "defined"}}{{template "defined" .}}
{{- else}}{{template "alias" .}}
{{- end}}
{{end}}
{{- end}}

{{define "struct"}}
{{typeDoc .}}
type {{.Name}} struct {
{{- range .Fields}}
{{- with fieldDoc .}}
{{.}}
{{- end}}
	{{.Name}} {{goType .Type}} {{tag .}}
{{- end}}
{{- range .InlineUnions}}
	// {{.Name}} holds the variant of the object; its properties are
	// decoded from and encoded into the object itself.
	{{.Name}} {{goType .Type}} `json:"-"`
{{- end}}
{{- with .Additional}}{{if not .Forbidden}}
	// {{.FieldName}} holds the properties that are not declared above.
	{{.FieldName}} map[string]{{goType .Value}} `json:"-"`
{{- end}}{{end}}
}

// UnmarshalJSON decodes a JSON object, reporting missing required
// properties and values of the wrong type with their JSON paths.
// Required read-only and write-only properties may be absent; use
// DecodeJSON to decode a request or response.
func (m *{{.Name}}) UnmarshalJSON(data []byte) error {
	return m.DecodeJSON(data, oapi.AnyDirection)
}

// DecodeJSON decodes a JSON object like UnmarshalJSON. dir decides whether
// required read-only properties (responses) and required write-only
// properties (requests) must be present.
func (m *{{.Name}}) DecodeJSON(data []byte, dir oapi.Direction) error {
	return oapi.DecodeObjectWith(data, func(dec *{{imp "encoding/json/jsontext" "jsontext"}}.Decoder) error {
{{- if .InlineUnions}}
{{streamDecodeStmts .}}
{{- else}}
		return m.DecodeJSONFrom(dec, dir)
{{- end}}
	})
}

// UnmarshalJSONFrom decodes a JSON object from dec like UnmarshalJSON,
// token by token.
func (m *{{.Name}}) UnmarshalJSONFrom(dec *jsontext.Decoder) error {
	return m.DecodeJSONFrom(dec, oapi.AnyDirection)
}

// DecodeJSONFrom decodes a JSON object from dec like DecodeJSON.
func (m *{{.Name}}) DecodeJSONFrom(dec *jsontext.Decoder, dir oapi.Direction) error {
{{- if .InlineUnions}}
	// The inline unions decode from the object's text.
	data, err := dec.ReadValue()
	if err != nil {
		return err
	}
	return m.DecodeJSON(data, dir)
{{- else}}
{{streamDecodeStmts .}}
{{- end}}
}


// MarshalJSON encodes every property that is present.
func (m {{.Name}}) MarshalJSON() ([]byte, error) {
	return m.EncodeJSON(oapi.AnyDirection)
}

// EncodeJSON encodes the value for dir: read-only properties are left out
// of requests and write-only properties out of responses.
func (m {{.Name}}) EncodeJSON(dir oapi.Direction) ([]byte, error) {
	return m.AppendJSON(nil, dir)
}

// AppendJSON appends the value to dst as EncodeJSON encodes it.
func (m {{.Name}}) AppendJSON(dst []byte, dir oapi.Direction) ([]byte, error) {
{{appendStmts .}}
}

// Validate checks the values against the constraints of the schema.
func (m {{.Name}}) Validate() error {
	var errs oapi.ValidationErrors
{{validateStmts .}}
	return errs.Err()
}
{{- alternativeMethods .}}
{{- propertyNameMethod .}}
{{- end}}

{{define "union"}}
{{typeDoc .}}
//
{{- if .Sealed}}
// It holds exactly one variant: create it with {{.Sealed.Constructor}} and read
// it with Value.
{{- if .Discriminator}} The property {{printf "%q" .Discriminator}} selects the
// variant when decoding.{{end}}
type {{.Name}} struct {
	value {{.Sealed.Interface}}
}
{{sealedDecls .}}
{{- else}}
// {{if .OneOf}}Exactly one{{else}}At least one{{end}} of the fields is set.
{{- if .Discriminator}} The property {{printf "%q" .Discriminator}} selects
// the variant when decoding.{{end}}
type {{.Name}} struct {
{{- range .Variants}}
{{variantDoc $ .}}
	{{.Name}} *{{goType .Type}}
{{- end}}
}
{{- end}}

// UnmarshalJSON decodes the value as the matching variant. Required
// read-only and write-only properties may be absent; use DecodeJSON to
// decode a request or response.
func (u *{{.Name}}) UnmarshalJSON(data []byte) error {
	return u.DecodeJSON(data, oapi.AnyDirection)
}

// DecodeJSON decodes the value like UnmarshalJSON, passing dir on to the
// variants.
func (u *{{.Name}}) DecodeJSON(data []byte, dir oapi.Direction) error {
{{unionDecodeStmts .}}
}

// MarshalJSON encodes the variant that is set{{if not .OneOf}}; objects of several
// variants that are set are merged{{end}}.
func (u {{.Name}}) MarshalJSON() ([]byte, error) {
	return u.EncodeJSON(oapi.AnyDirection)
}

// EncodeJSON encodes the variant like MarshalJSON, passing dir on to it.
func (u {{.Name}}) EncodeJSON(dir oapi.Direction) ([]byte, error) {
{{- if .Sealed}}
	return u.AppendJSON(nil, dir)
{{- else}}
{{unionMarshalStmts .}}
{{- end}}
}
{{- if .Sealed}}

// AppendJSON appends the variant to dst as EncodeJSON encodes it.
func (u {{.Name}}) AppendJSON(dst []byte, dir oapi.Direction) ([]byte, error) {
{{unionAppendStmts .}}
}
{{- end}}

// Validate checks that {{if .Sealed}}a{{else if .OneOf}}exactly one{{else}}at least one{{end}} variant is set, and validates it.
func (u {{.Name}}) Validate() error {
	var errs oapi.ValidationErrors
{{unionValidateStmts .}}
	return errs.Err()
}
{{- end}}

{{define "enum"}}
{{typeDoc .}}
type {{.Name}} {{goType .Base}}

// Values of {{.Name}}.
const (
{{- range .Values}}
{{- if .Doc}}
	// {{.Name}}: {{.Doc}}
{{- end}}
	{{.Name}} {{$.Name}} = {{.Literal}}
{{- end}}
)

// Validate checks that the value is one of the constants.
func (e {{.Name}}) Validate() error {
	switch e {
	case {{range $i, $v := .Values}}{{if $i}}, {{end}}{{$v.Name}}{{end}}:
		return nil
	}
	return &oapi.ValidationError{Message: {{enumMessage .}}}
}
{{- end}}

{{define "defined"}}
{{typeDoc .}}
type {{.Name}} {{goType .Underlying}}

// Validate checks the value against the constraints of the schema.
func (v {{.Name}}) Validate() error {
	var errs oapi.ValidationErrors
{{validateStmts .}}
	return errs.Err()
}
{{- alternativeMethods .}}
{{- end}}

{{define "alias"}}
{{typeDoc .}}
type {{.Name}} = {{goType .Underlying}}
{{- end}}
