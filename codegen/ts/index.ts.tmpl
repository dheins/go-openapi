{{- /*
Templates of index.ts, which re-exports the runtime's names users need
(.Names), the models and the client.
*/ -}}

{{define "index"}}export { {{join .Names ", "}} } from "./runtime.ts";
export * as runtime from "./runtime.ts";
export * from "./models.ts";
{{if .Client}}export * from "./client.ts";
{{end}}{{end}}
