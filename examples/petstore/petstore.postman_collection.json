{
  "info": {
    "name": "goapi petstore example",
    "description": "Requests and tests for the example server in examples/petstore, generated by goapi.\n\nStart the server:\n\n    cd examples/petstore && go run . -key secret\n\nThen run the Document, Health, Pets and Errors folders: in the Collection Runner, deselect the Streaming folder; with Newman, `newman run petstore.postman_collection.json --folder Document --folder Health --folder Pets --folder Errors`. Pets creates a pet and reuses its id; Errors checks every error response. The Streaming folder holds a server-sent events request that stays open until cancelled, which would stall a run: send it on its own.\n\nVariables: `baseUrl` (default http://localhost:8080/v1) and `apiKey` (default `secret`, the -key the server was started with).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/v1" },
    { "key": "apiKey", "value": "secret" },
    { "key": "petId", "value": "" },
    { "key": "petName", "value": "" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Every error the server sends is RFC 9457 problem details.",
          "if (pm.response.code >= 400) {",
          "    pm.test('error is application/problem+json', function () {",
          "        pm.response.to.have.header('Content-Type', 'application/problem+json');",
          "        pm.expect(pm.response.json().status).to.eql(pm.response.code);",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Document",
      "item": [
        {
          "name": "Get the OpenAPI document",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/openapi.json", "host": ["{{baseUrl}}"], "path": ["openapi.json"] },
            "description": "The document the server was generated from, served because the example uses server.WithDocument."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with the document', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const doc = pm.response.json();",
                  "    pm.expect(doc.openapi).to.eql('3.2.0');",
                  "    pm.expect(doc.info.title).to.eql('Petstore example');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Check health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "The health check: plain text OK, with no API key needed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with OK as plain text', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain');",
                  "    pm.expect(pm.response.text()).to.eql('OK');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Pets",
      "item": [
        {
          "name": "Create a pet",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{petName}}\",\n  \"status\": \"available\",\n  \"tags\": [\"dog\", \"friendly\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/pets", "host": ["{{baseUrl}}"], "path": ["pets"] },
            "description": "Requires the API key. The id is read-only: the server assigns it and ignores one sent by the client."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A unique name, so the collection can run again without a 409.",
                  "pm.collectionVariables.set('petName', 'Rex-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 with the new pet', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const pet = pm.response.json();",
                  "    pm.expect(pet.name).to.eql(pm.collectionVariables.get('petName'));",
                  "    pm.expect(pet.status).to.eql('available');",
                  "    pm.expect(pet.id).to.be.a('number');",
                  "    pm.collectionVariables.set('petId', pet.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List pets",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/pets?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["pets"],
              "query": [
                { "key": "limit", "value": "20", "description": "1 to 100, default 20" },
                { "key": "after", "value": "", "description": "Return pets with an id greater than this (from X-Next)", "disabled": true }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with a list including the new pet', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const pets = pm.response.json();",
                  "    pm.expect(pets).to.be.an('array');",
                  "    const id = Number(pm.collectionVariables.get('petId'));",
                  "    pm.expect(pets.map(p => p.id)).to.include(id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List pets, one per page",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/pets?limit=1",
              "host": ["{{baseUrl}}"],
              "path": ["pets"],
              "query": [{ "key": "limit", "value": "1" }]
            },
            "description": "When there are more pets, X-Next holds the value of after for the next page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with at most one pet', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().length).to.be.at.most(1);",
                  "});",
                  "const next = pm.response.headers.get('X-Next');",
                  "if (next) {",
                  "    pm.test('X-Next is the id of the last pet on the page', function () {",
                  "        pm.expect(Number(next)).to.eql(pm.response.json()[0].id);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List pets by status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/pets?status=available,pending",
              "host": ["{{baseUrl}}"],
              "path": ["pets"],
              "query": [{ "key": "status", "value": "available,pending", "description": "Comma-separated (form style, explode: false)" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with only available or pending pets', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.response.json().forEach(p => pm.expect(['available', 'pending']).to.include(p.status));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the pet",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/pets/{{petId}}", "host": ["{{baseUrl}}"], "path": ["pets", "{{petId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with the pet', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const pet = pm.response.json();",
                  "    pm.expect(pet.id).to.eql(Number(pm.collectionVariables.get('petId')));",
                  "    pm.expect(pet.tags).to.eql(['dog', 'friendly']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the pet",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "url": { "raw": "{{baseUrl}}/pets/{{petId}}", "host": ["{{baseUrl}}"], "path": ["pets", "{{petId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 without a body', function () {", "    pm.response.to.have.status(204);", "    pm.expect(pm.response.text()).to.eql('');", "});"]
              }
            }
          ]
        },
        {
          "name": "Get the deleted pet",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/pets/{{petId}}", "host": ["{{baseUrl}}"], "path": ["pets", "{{petId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 naming the pet', function () {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.json().detail).to.include('no pet with id');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "Create without an API key (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\": \"Nobody\", \"status\": \"available\"}" },
            "url": { "raw": "{{baseUrl}}/pets", "host": ["{{baseUrl}}"], "path": ["pets"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401', function () {", "    pm.response.to.have.status(401);", "    pm.expect(pm.response.json().detail).to.eql('authentication is required');", "});"]
              }
            }
          ]
        },
        {
          "name": "Create with a wrong API key (401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "not-the-key" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\": \"Nobody\", \"status\": \"available\"}" },
            "url": { "raw": "{{baseUrl}}/pets", "host": ["{{baseUrl}}"], "path": ["pets"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 without details from the key check', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().detail).to.eql('the credentials are not valid');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create an invalid pet (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\": \"\", \"status\": \"lost\", \"tags\": [\"a\", \"a\"]}" },
            "url": { "raw": "{{baseUrl}}/pets", "host": ["{{baseUrl}}"], "path": ["pets"] },
            "description": "Every problem is listed, each with a JSON pointer into the body."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 listing every problem', function () {",
                  "    pm.response.to.have.status(400);",
                  "    const errors = pm.response.json().errors;",
                  "    const pointers = errors.map(e => e.pointer).sort();",
                  "    pm.expect(pointers).to.eql(['/name', '/status', '/tags']);",
                  "    errors.forEach(e => pm.expect(e.in).to.eql('body'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a malformed pet (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\": 42}" },
            "url": { "raw": "{{baseUrl}}/pets", "host": ["{{baseUrl}}"], "path": ["pets"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 with a type error and a missing property', function () {",
                  "    pm.response.to.have.status(400);",
                  "    const details = pm.response.json().errors.map(e => e.pointer + ': ' + e.detail).sort();",
                  "    pm.expect(details).to.eql(['/name: expected string, got number', '/status: required property is missing']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a duplicate pet (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\": \"{{petName}}\", \"status\": \"pending\"}" },
            "url": { "raw": "{{baseUrl}}/pets", "host": ["{{baseUrl}}"], "path": ["pets"] },
            "description": "The pre-request script creates a pet with this name first."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const name = 'Twin-' + Date.now();",
                  "pm.collectionVariables.set('petName', name);",
                  "pm.sendRequest({",
                  "    url: pm.variables.get('baseUrl') + '/pets',",
                  "    method: 'POST',",
                  "    header: { 'X-API-Key': pm.variables.get('apiKey'), 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ name: name, status: 'available' }) }",
                  "}, function (err, res) {",
                  "    if (err || res.code !== 201) {",
                  "        console.error('could not create the first pet', err || res.code);",
                  "    }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', function () {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.json().detail).to.include('already exists');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List with an invalid limit (400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/pets?limit=500&status=lost",
              "host": ["{{baseUrl}}"],
              "path": ["pets"],
              "query": [
                { "key": "limit", "value": "500" },
                { "key": "status", "value": "lost" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 naming both query parameters', function () {",
                  "    pm.response.to.have.status(400);",
                  "    const errors = pm.response.json().errors;",
                  "    pm.expect(errors.map(e => e.in + ' ' + e.parameter).sort()).to.eql(['query limit', 'query status']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get a pet with a non-numeric id (400)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/pets/abc", "host": ["{{baseUrl}}"], "path": ["pets", "abc"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 for the path parameter', function () {",
                  "    pm.response.to.have.status(400);",
                  "    const e = pm.response.json().errors[0];",
                  "    pm.expect(e.in + ' ' + e.parameter).to.eql('path petId');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create with the wrong content type (415)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "text/plain" }
            ],
            "body": { "mode": "raw", "raw": "Rex" },
            "url": { "raw": "{{baseUrl}}/pets", "host": ["{{baseUrl}}"], "path": ["pets"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('415', function () {", "    pm.response.to.have.status(415);", "});"]
              }
            }
          ]
        },
        {
          "name": "Use an undeclared method (405)",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/pets/1", "host": ["{{baseUrl}}"], "path": ["pets", "1"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('405 with the allowed methods', function () {",
                  "    pm.response.to.have.status(405);",
                  "    const allow = pm.response.headers.get('Allow');",
                  "    ['GET', 'DELETE'].forEach(m => pm.expect(allow).to.include(m));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Request an unknown path (404)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/owners", "host": ["{{baseUrl}}"], "path": ["owners"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404', function () {", "    pm.response.to.have.status(404);", "});"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Streaming (send manually)",
      "description": "Server-sent events stay open until you cancel them, so leave this folder out of collection runs. Send the request on its own, then create a pet in another tab to see an event arrive.",
      "item": [
        {
          "name": "Watch new pets (server-sent events)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "text/event-stream" }],
            "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] },
            "description": "Each new pet arrives as an event named \"pet\" whose data is the pet as JSON."
          }
        }
      ]
    }
  ]
}
